# Database
DATABASE_URL="mysql://user:password@localhost:3306/ziriuz"

# NextAuth.js v5
AUTH_SECRET="your-auth-secret-here-generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# JWT Keys (RS256) — generate with: openssl genrsa -out private.pem 2048
AUTH_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
AUTH_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Redis
REDIS_URL="redis://localhost:6379"

# Email (Nodemailer)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@ziriuz.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="ZIRIUZ <noreply@ziriuz.com>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
